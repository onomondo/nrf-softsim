 *
 * Same nvs_storage partition as tests/apdu/boards/native_sim.overlay; ss_fs.c
 * needs it to resolve PARTITION_*(nvs_storage) on native_sim's flash0.
 */

&flash0 {
	partitions {
		nvs_storage: partition@100000 {
			label = "nvs_storage";
			reg = <0x00100000 0x00008000>;
		};
	};
};
